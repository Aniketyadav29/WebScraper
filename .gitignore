# ============================================================
# .gitignore — Competitor Intelligence & Dynamic Pricing Engine
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
env/
venv/
.venv/
ENV/
pip-log.txt

# --- Environment Variables (NEVER commit secrets) ---
.env

# --- Data files (can be regenerated by scraper/pipeline) ---
**/*.csv
**/*.db
**/*.sqlite
**/*.db-shm
**/*.db-wal
**/data/ecommerce_100k_catalog.json

# --- ML Model artifacts (large binary files) ---
**/*.joblib
**/*.pkl

# --- Logs ---
**/*.log

# --- IDE / OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Playwright browser binaries ---
playwright-browsers/
