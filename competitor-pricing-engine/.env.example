# ============================================================
# Competitor Intelligence & Dynamic Pricing Engine
# Environment Variables — Copy this file to `.env` and fill in values.
# NEVER commit your actual `.env` file to version control.
# ============================================================

# --- Application Settings ---
APP_NAME="Competitor Intelligence & Dynamic Pricing Engine"
APP_ENV=development          # Options: development | staging | production
DEBUG=True
LOG_LEVEL=INFO               # Options: DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- Scraper Settings ---
SCRAPER_DELAY_MIN=1.5        # Minimum seconds between requests (be respectful)
SCRAPER_DELAY_MAX=3.5        # Maximum seconds between requests
SCRAPER_MAX_RETRIES=3        # Number of retry attempts on failure
SCRAPER_HEADLESS=True        # Run browser in headless mode (True/False)
SCRAPER_TIMEOUT=30000        # Page load timeout in milliseconds

# --- Target URLs (comma-separated for multiple targets) ---
TARGET_URLS="https://books.toscrape.com,https://books.toscrape.com/catalogue/page-2.html"
SCRAPER_OUTPUT_DIR=data/raw

# --- Database Settings ---
DATABASE_URL=sqlite:///./data/db/pricing_engine.db
DB_ECHO=False                # Log all SQL statements (set True for debugging)

# --- ML Model Settings ---
MODEL_DIR=models/
MODEL_NAME=pricing_model.joblib
RANDOM_STATE=42
TEST_SIZE=0.2

# --- API Settings ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:5500"  # Allowed CORS origins
